# Supabase project (Settings → API). The publishable key is safe to expose to the browser;
# row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional: a self-hosted postcodes.io instance for heavy UK geocoding. Defaults to the public API.
# POSTCODES_IO_URL=https://api.postcodes.io
