# Copy to .env.local for local overrides. With nothing set, the app runs fully
# locally: embedded Postgres (PGlite) and mock WhatsApp, payments, scoring and email.
# Never commit real values.

# --- App ---
APP_URL=http://localhost:3000
# 32+ random chars. Required in production.
SESSION_SECRET=
# 64 hex chars (openssl rand -hex 32). Encrypts candidate phone numbers. Required in production.
# Changing it makes existing encrypted numbers unreadable: rotate with a migration, not by editing.
DATA_ENCRYPTION_KEY=
SUPPORT_EMAIL=support@example.com
# Comma-separated emails that can open /ops (platform funnel and cost view).
OPS_EMAILS=
# "true" shows the one-click demo workspace (always simulated, never real messages or payments).
DEMO_MODE=true

# --- Database ---
# Managed Postgres connection string. Unset = embedded PGlite in PGLITE_DIR (local only).
DATABASE_URL=
PGLITE_DIR=.data/pglite

# --- Pricing (INR) ---
# Placeholder until set from customer interviews (see TODO.md).
PRICE_PER_JOB_INR=1499
MAX_CANDIDATES_PER_JOB=200
TEST_MODE_MAX_CANDIDATES=5
RETENTION_DAYS=90

# --- WhatsApp: mock | cloud ---
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# Names of your approved templates in Meta Business Manager.
WHATSAPP_INVITE_TEMPLATE=screening_invite
WHATSAPP_REMINDER_TEMPLATE=screening_reminder
WHATSAPP_SENDS_PER_MINUTE=60

# --- Scoring: mock | claude ---
SCORER_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Speech-to-text: mock (real provider not chosen yet, see TODO.md) ---
STT_PROVIDER=mock

# --- Payments: mock | razorpay ---
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email: console | resend ---
MAILER_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=ReplyHire <hello@example.com>

# --- Background jobs ---
# Vercel Cron sends this as a Bearer token to /api/cron.
CRON_SECRET=
